generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  passwordHash String
  classes      Class[]
  subjects     Subject[]
  users        User[]
  onlineTests  OnlineTest[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Class {
  id        String       @id @default(cuid())
  name      String       // e.g., "Class 10", "Grade 8"
  schoolId     String
  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users        User[]       @relation("UserClasses")
  students     Student[]
  subjectAccess TeacherSubjectAccess[]
  onlineTests   OnlineTest[]
  
  @@unique([name, schoolId])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Subject {
  id        String       @id @default(cuid())
  name      String       // e.g., "Overall Cumulative", "English", "Science"
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scores       Score[]
  teacherAccess TeacherSubjectAccess[]
  onlineTests   OnlineTest[]
  
  @@unique([name, schoolId])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Student {
  id                 String       @id @default(cuid())
  registrationNumber String?
  rollNumber         String?
  name               String
  fatherName         String?
  fatherPhone        String?
  fatherCnic         String?
  showInLeaderboard  Boolean      @default(false)
  section            String?      // e.g., "A", "B"
  classId            String
  class              Class        @relation(fields: [classId], references: [id])
  scores             Score[]
  testAttempts       TestAttempt[]
  
  @@unique([classId, rollNumber]) // Prevent duplicate roll numbers in the same class
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Score {
  id            String   @id @default(cuid())
  studentId     String
  subjectId     String
  testName      String
  marksObtained Float
  totalMarks    Float
  percentage    Float
  isAbsent      Boolean  @default(false)

  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, testName]) // A student has one score per test per subject
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Role {
  TEACHER
  STUDENT
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         Role
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes      Class[]  @relation("UserClasses")
  subjectAccess TeacherSubjectAccess[]
  onlineTests   OnlineTest[]
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TeacherSubjectAccess {
  id        String   @id @default(cuid())
  userId    String
  classId   String
  subjectId String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, classId, subjectId])
}

model OnlineTest {
  id          String   @id @default(cuid())
  title       String
  testName    String   // Matches the testName in Score
  totalMarks  Float
  isActive    Boolean  @default(false)
  schoolId    String
  teacherId   String
  classId     String
  subjectId   String

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  variants    TestVariant[]
  attempts    TestAttempt[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TestVariant {
  id            String   @id @default(cuid())
  testId        String
  name          String
  accessPin     String
  content       String   // HTML/Rich text questions
  
  test          OnlineTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  attempts      TestAttempt[]

  @@unique([testId, accessPin])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum AttemptStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  GRADED
}

model TestAttempt {
  id              String   @id @default(cuid())
  studentId       String
  testId          String
  variantId       String
  
  status          AttemptStatus @default(IN_PROGRESS)
  answers         String?       // JSON or HTML of answers
  annotatedImage  String?       // Cloudinary URL for graded image
  obtainedMarks   Float?
  feedback        String?

  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  test            OnlineTest @relation(fields: [testId], references: [id], onDelete: Cascade)
  variant         TestVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([studentId, testId]) // Only one attempt per test
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
