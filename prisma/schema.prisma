generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id           String    @id @default(cuid())
  name         String
  username     String    @unique
  passwordHash String
  classes      Class[]
  subjects     Subject[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Class {
  id        String       @id @default(cuid())
  name      String       // e.g., "Class 10", "Grade 8"
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  students  Student[]
  
  @@unique([name, schoolId])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Subject {
  id        String       @id @default(cuid())
  name      String       // e.g., "Overall Cumulative", "English", "Science"
  schoolId  String
  school    School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  scores    Score[]
  
  @@unique([name, schoolId])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Student {
  id                 String       @id @default(cuid())
  registrationNumber String?
  rollNumber         String?
  name               String
  fatherName         String?
  fatherPhone        String?
  fatherCnic         String?
  section            String?      // e.g., "A", "B"
  classId            String
  class              Class        @relation(fields: [classId], references: [id])
  scores             Score[]
  
  @@unique([name, classId, section]) // Prevent duplicate students in the same section/class
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
}

model Score {
  id            String   @id @default(cuid())
  studentId     String
  subjectId     String
  testName      String
  marksObtained Float
  totalMarks    Float
  percentage    Float
  isAbsent      Boolean  @default(false)

  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([studentId, subjectId, testName]) // A student has one score per test per subject
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
